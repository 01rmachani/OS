# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# ── AI Provider ──────────────────────────────────────────────────────────────
# Which provider to use: openai | anthropic | ollama | openrouter | custom
AI_PROVIDER=openai

# Model name — must be valid for the selected provider
AI_MODEL=gpt-4o-mini

# API key — required for openai, anthropic, openrouter; optional for ollama
AI_API_KEY=

# Base URL — required for ollama, openrouter, and custom providers
# Examples:
#   Ollama local:    AI_BASE_URL=http://localhost:11434/v1
#   OpenRouter:      AI_BASE_URL=https://openrouter.ai/api/v1
#   Custom OpenAI-compatible endpoint:
#                    AI_BASE_URL=https://my-llm-proxy.example.com/v1
AI_BASE_URL=

# ── Next.js basePath ─────────────────────────────────────────────────────────
# Leave empty for local development (app runs at /)
# For Docker/K8s builds this is passed as --build-arg BASE_PATH=/chat-app
# BASE_PATH=
